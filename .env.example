# ─────────────────────────────────────────────────────────────
# WorkBuddy2API 配置示例
# 复制成 .env 后填写。.env 已被 .gitignore 排除，切勿提交。
# ─────────────────────────────────────────────────────────────

# ===== 必填：WorkBuddy 登录态 =====
# 获取方式见 docs/02-获取Token.md
# access token 过期时间约 30 天，refresh token 约 60 天
CODEBUDDY_AUTH_TOKEN=
CODEBUDDY_REFRESH_TOKEN=
# 可选：不填会从 token 里解析
CODEBUDDY_DOMAIN=www.workbuddy.cn
CODEBUDDY_USER_ID=
# 企业账号才需要
CODEBUDDY_ENTERPRISE_ID=

# 上面两个时间戳（毫秒）。留空则由服务端解析 token 自带的 exp
CODEBUDDY_EXPIRES_AT=
CODEBUDDY_REFRESH_EXPIRES_AT=

# ===== 上游地址 =====
CODEBUDDY_API_BASE=https://copilot.tencent.com
# 查询积分余额用，注意不带 /v2 前缀
CODEBUDDY_BILLING_BASE=https://www.workbuddy.cn

# ===== 对外提供的 API =====
# 客户端请求时携带的 Key：Authorization: Bearer <API_KEY>
# 建议用一串随机字符，例如 python -c "import secrets;print('sk-wb-'+secrets.token_hex(20))"
API_KEY=
DEFAULT_MODEL=deepseek-v3
DEFAULT_THINKING=high
MAX_TOKENS_DEFAULT=8192
PORT=8000

# ===== 控制面板（/admin）=====
ADMIN_PASSWORD=change-me
# 数据库路径。容器里指向挂载卷；本机跑默认落在项目目录
ADMIN_DB=./admin.db
# 积分信息缓存秒数
ADMIN_CREDIT_REFRESH_SEC=60
# 管理会话有效期（秒）
ADMIN_SESSION_TTL=43200

# ===== 调试 =====
# 置 1 会把模型的流式输出打到 stdout（容器里会刷屏，平时别开）
CODEBUDDY_VERBOSE_STREAM=0

# ===== 部署后（可选）=====
# 线上地址，update.py verify 会拿它做健康检查
PUBLIC_BASE=http://127.0.0.1:8000

# ===== 容器持久化（仅 CasaOS 部署用到）=====
# 刷新后的 token 落盘位置，避免容器重启后 refresh token 轮换失效
CODEBUDDY_TOKEN_CACHE=/data/token.json
